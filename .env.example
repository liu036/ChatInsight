# ChatInsight 配置示例：复制为 .env 后按需修改（.env 已在 .gitignore 中，不会提交）

# 运行模式：mock = 内置规则引擎（无需 API Key，可直接演示）；real = 调用真实 LLM
CHATINSIGHT_MODE=mock

# 以下仅在 real 模式生效：任何 OpenAI 兼容端点均可
# （DeepSeek / 通义千问 / 智谱 / Ollama 本地模型等）
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
# Ollama 本地示例：http://localhost:11434/v1
CHATINSIGHT_MODEL=gpt-4o-mini
CHATINSIGHT_TEMPERATURE=0.1

# 并发与容错
CHATINSIGHT_MAX_WORKERS=5
CHATINSIGHT_TIMEOUT=60
CHATINSIGHT_MAX_RETRIES=2

# 分组参数
CHATINSIGHT_SESSION_GAP_MINUTES=30
CHATINSIGHT_CONTEXT_TAIL=5
